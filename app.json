        "NSLocationAlwaysAndWhenInUseUsageDescription": "RunWithAI bruger din placering til at tracke dine løberuter, også når appen kører i baggrunden under dit løb.",
        "NSMotionUsageDescription": "RunWithAI bruger bevægelsessensorer til at forbedre distance-beregning og skridttælling under dine løbeture.",
        "NSHealthShareUsageDescription": "RunWithAI bruger dine sundhedsdata til at vise puls og kalorier under løb.",
        "NSHealthUpdateUsageDescription": "RunWithAI gemmer dine løbeture i Apple Health.",
        "NSCameraUsageDescription": "RunWithAI bruger kameraet til at tage billeder til din profil og dele løbeoplevelser med venner.",
        "NSMicrophoneUsageDescription": "RunWithAI bruger mikrofonen til stemmekommandoer under løb, så du kan styre appen håndfrit mens du løber.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBWEWmIbDI57D9p2gsUnJrJmEzrnLdC808"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.runwithai",

      "versionCode": 50,

      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBWEWmIbDI57D9p2gsUnJrJmEzrnLdC808"
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RunWithAI bruger din placering til at tracke dine løberuter, også når appen kører i baggrunden under dit løb.",
